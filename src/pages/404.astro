---
import Base from '../layouts/Base.astro';
import { meta, notFound } from '../content/site';
---
<Base title={meta.notFound.title} description={meta.notFound.description} path="/404">
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6 md:py-32">
    <h1 class="text-4xl font-semibold md:text-5xl">{notFound.h1}</h1>
    <p class="mt-8"><a href="/" class="btn">{notFound.back}</a></p>
  </section>
</Base>
