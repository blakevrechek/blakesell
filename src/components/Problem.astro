---
import Section from './Section.astro';
import { problem } from '../content/site';
---
<Section heading={problem.heading} tone="panel">
  <ul class="grid gap-px overflow-hidden rounded-sm border border-rule bg-rule md:grid-cols-3">
    {problem.cards.map((c) => (
      <li class="bg-paper p-6 md:p-8">
        <h3 class="mb-3 text-xl font-semibold">{c.title}</h3>
        <p class="text-muted">{c.body}</p>
      </li>
    ))}
  </ul>
</Section>
