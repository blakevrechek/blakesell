---
import { legalDraftBanner } from '../content/site';
interface Props { h1: string; updated: string; sections: { heading: string; body: string[] }[] }
const { h1, updated, sections } = Astro.props;
---
<article class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
  {legalDraftBanner && <p role="note" class="mb-10 inline-block border-2 border-error px-4 py-2 font-sans text-sm font-bold uppercase tracking-wide text-error">
    {legalDraftBanner}
  </p>}
  <h1 class="text-4xl font-semibold md:text-5xl">{h1}</h1>
  <p class="mt-4 font-sans text-sm text-muted">Effective {updated}</p>
  <div class="prose-legal measure mt-6">
    {sections.map((s) => (
      <section>
        <h2>{s.heading}</h2>
        {s.body.map((p) => <p>{p}</p>)}
      </section>
    ))}
  </div>
</article>
