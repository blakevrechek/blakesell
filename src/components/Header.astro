---
import { config, nav } from '../content/site';
interface Props { showNav?: boolean }
const { showNav = false } = Astro.props;
---
<header class="border-b border-rule bg-paper/95 md:sticky md:top-0 md:z-40 md:backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-3 sm:px-6">
    <a href="/" class="font-serif text-lg font-semibold tracking-tight text-ink no-underline hover:text-accent">
      {config.businessName}
    </a>
    <nav aria-label="Primary" class="flex items-center gap-6">
      {showNav && (
        <ul class="hidden items-center gap-6 font-sans text-sm md:flex">
          {nav.links.map((l) => (
            <li><a href={l.href} class="text-ink no-underline hover:text-accent hover:underline">{l.label}</a></li>
          ))}
        </ul>
      )}
      <a href={config.bookingUrl} class="btn">{nav.cta}</a>
    </nav>
  </div>
</header>
