---
import Section from './Section.astro';
import { faq } from '../content/site';
---
<Section heading={faq.heading} tone="panel">
  <div class="max-w-3xl divide-y divide-rule border-y border-rule">
    {faq.items.map((f) => (
      <details class="group py-5">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-lg font-semibold [&::-webkit-details-marker]:hidden">
          <span>{f.q}</span>
          <span aria-hidden="true" class="font-sans text-accent group-open:rotate-45">+</span>
        </summary>
        <p class="measure mt-3 text-muted">{f.a}</p>
      </details>
    ))}
  </div>
</Section>
